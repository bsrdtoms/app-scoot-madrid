# ── ScootMap — variables d'environnement ──────────────────────────────────
# Copier en `.env` et remplir. Aucune de ces valeurs n'est versionnée.

# Port du serveur (défaut : 3000)
PORT=3000

# Secret de signature des JWT applicatifs (générer une longue chaîne aléatoire)
JWT_SECRET=change-me-with-a-long-random-string

# ── Credentials opérateurs ────────────────────────────────────────────────
# Acciona — OAuth2 client_credentials (extraits de la config de l'app mobile)
ACCIONA_CLIENT_ID=
ACCIONA_CLIENT_SECRET=

# Cabify (Movo) — token Bearer + device uuid extraits de l'app Android
# Voir BACKEND.md › « Token Cabify » pour la procédure d'extraction
CABIFY_TOKEN=
CABIFY_DEVICE_UUID=
